# Copy to .env and fill in. Without credentials the system runs in DRY_RUN mode
# (messages are logged, nothing is actually sent).

DRY_RUN=true
DATABASE_PATH=outreach.db
TIMEZONE=Africa/Lagos
BUSINESS_NAME=Your Business

# Dashboard login (HTTP Basic). Leave blank to disable auth (local use only!)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Daily automatic run: hour of day (0-23, in TIMEZONE)
SEND_HOUR=9

# Delay between messages on each channel (seconds)
MIN_DELAY_SECONDS=1
MAX_DELAY_SECONDS=2

# Used to turn local numbers (e.g. 0803...) into international format for WhatsApp
DEFAULT_COUNTRY_CODE=234
# How to read ambiguous CSV dates like 03/04/1990: DMY or MDY
CSV_DATE_ORDER=DMY

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Business-initiated WhatsApp messages must use an approved template.
# Templates should take 2 body params: {{1}} = first name, {{2}} = offer text.
WHATSAPP_TEMPLATE_BIRTHDAY=
WHATSAPP_TEMPLATE_FESTIVAL=
WHATSAPP_TEMPLATE_LANG=en

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
